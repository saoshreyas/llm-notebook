# Required for OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Default model (LiteLLM OpenRouter id)
DEFAULT_MODEL=openrouter/openai/gpt-oss-20b:free
#"openai/gpt-oss-20b:free"
# API server
HOST=0.0.0.0
PORT=8000

# NL → DSL parse-repair attempts
NL_PARSE_MAX_ATTEMPTS=3

# Optional: local OpenAI-compatible server
# VLLM_BASE_URL=http://localhost:8000/v1

# Optional alternate keys (if OPENROUTER_API_KEY unset)
# OPENAI_API_KEY=
# HUGGINGFACE_API_KEY=
# HF_TOKEN=
