# ── Ollama Cloud (default) ──────────────────────────────────────────────────
# 1. Create a key: https://ollama.com/settings/keys
# 2. Paste it below (or copy this file to `.env` in the repo root)

OLLAMA_API_KEY=your_ollama_api_key_here

# Cloud host (default). Do not add /v1 — LiteLLM uses Ollama's /api/chat.
OLLAMA_API_BASE=https://ollama.com

# Model id as shown on ollama.com (no provider prefix needed)
# Free-tier friendly defaults; many frontier models need https://ollama.com/upgrade
DEFAULT_MODEL=gpt-oss:20b
# Other free-ish options: gemma3:12b, gpt-oss:120b, glm-4.7
# Often paid: deepseek-v4-flash, kimi-k2.7-code, glm-5.1, minimax-m3

# ── API server ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# NL → DSL parse-repair attempts
NL_PARSE_MAX_ATTEMPTS=3

# ── Optional: OpenRouter instead of Ollama ──────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# DEFAULT_MODEL=openrouter/openai/gpt-4o-mini

# ── Optional: local OpenAI-compatible server (vLLM / local Ollama /v1) ──────
# VLLM_BASE_URL=http://localhost:11434/v1
# DEFAULT_MODEL=llama3.2
