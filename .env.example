# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=your-ollama-api-key-here
# LiteLLM OpenAI-compatible path reads OPENAI_API_KEY
OPENAI_API_KEY=your-ollama-api-key-here

# Ollama Cloud OpenAI-compatible base URL
VLLM_BASE_URL=https://ollama.com/v1

# Default model (Ollama Cloud)
DEFAULT_MODEL=gpt-oss:20b

# API server
HOST=0.0.0.0
PORT=8000

# NL → DSL parse-repair attempts
NL_PARSE_MAX_ATTEMPTS=3
