// ============================================================
//  NotebookDSL Grammar — lalr + contextual lexer
//  File extension: .ndsl
//
//  Example:
//    pipeline my_analysis:
//      description: "loads and summarises sales data"
//      config:
//        model:   "mistral-7b"
//        retries: 3
//      global:
//        constraint error:   never use subprocess
//        constraint warning: prefer descriptive variable names
//      node load_data:
//        intent:  "load sales.csv into a DataFrame"
//        output:  "DataFrame"
//        constraint error: handle FileNotFoundError gracefully
//      node summarise:
//        kind:    code
//        intent:  "return mean, median, std of revenue"
//        input:   load_data
//        output:  "dict"
//        retries: 5
//
//      node explain:
//        kind:    llm
//        prompt:  "Summarize the statistics for a non-technical reader"
//        input:   summarise
// ============================================================

start: pipeline+

pipeline: KW_PIPELINE NAME COLON _NEWLINE _INDENT pipeline_body _DEDENT

pipeline_body: (description_stmt | config_block | global_block | node_block)+

description_stmt: KW_DESCRIPTION COLON QSTRING _NEWLINE

config_block: KW_CONFIG COLON _NEWLINE _INDENT config_stmt+ _DEDENT
config_stmt: KW_MODEL   COLON QSTRING _NEWLINE -> config_model
           | KW_RETRIES COLON INT     _NEWLINE -> config_retries
           | KW_BACKEND COLON QSTRING _NEWLINE -> config_backend

global_block: KW_GLOBAL COLON _NEWLINE _INDENT constraint_stmt+ _DEDENT

node_block: KW_NODE NAME COLON _NEWLINE _INDENT node_body _DEDENT
node_body: node_stmt+
node_stmt: kind_stmt | intent_stmt | prompt_stmt | input_stmt | output_stmt | retries_stmt | constraint_stmt

kind_stmt   : KW_KIND   COLON KIND_VAL _NEWLINE
prompt_stmt : KW_PROMPT COLON QSTRING  _NEWLINE
intent_stmt : KW_INTENT COLON QSTRING  _NEWLINE
input_stmt  : KW_INPUT   COLON namelist _NEWLINE
output_stmt : KW_OUTPUT  COLON QSTRING  _NEWLINE
retries_stmt: KW_RETRIES COLON INT      _NEWLINE

// severity is optional; bare 'constraint:' defaults to error
constraint_stmt: KW_CONSTRAINT severity COLON CTEXT _NEWLINE
               | KW_CONSTRAINT COLON         CTEXT _NEWLINE

severity: KW_ERROR | KW_WARNING | KW_INFO

namelist: NAME (COMMA NAME)*

// --- Keywords ---
KW_PIPELINE   : "pipeline"
KW_NODE       : "node"
KW_DESCRIPTION: "description"
KW_CONFIG     : "config"
KW_GLOBAL     : "global"
KW_MODEL      : "model"
KW_RETRIES    : "retries"
KW_BACKEND    : "backend"
KW_KIND       : "kind"
KW_PROMPT     : "prompt"
KW_INTENT     : "intent"
KW_INPUT      : "input"
KW_OUTPUT     : "output"
KW_CONSTRAINT : "constraint"
KW_ERROR      : "error"
KW_WARNING    : "warning"
KW_INFO       : "info"

// --- Terminals ---
COLON  : ":"
COMMA  : ","
QSTRING: ESCAPED_STRING
CTEXT  : /[^\n]+/
INT    : /[0-9]+/
NAME     : /[a-zA-Z_][a-zA-Z0-9_]*/
KIND_VAL : "code" | "llm"

%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
COMMENT: /#[^\n]*/
%ignore COMMENT
_NEWLINE: /(\r?\n[\t ]*)+/
%declare _INDENT _DEDENT
